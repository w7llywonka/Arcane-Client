{
  "schemaVersion": 1,
  "id": "arcaneclient",
  "version": "${version}",
  "name": "Arcane Client",
  "description": "A 42-module Fabric client with combat tools, Auto Tool, a live Info HUD, configurable ESP, smooth camera modes, notifications, and a customizable Click GUI.",
  "authors": [
    "Eric and Codex"
  ],
  "contact": {
    "sources": "https://github.com/eiiorejierge/Arcane-Client",
    "issues": "https://github.com/eiiorejierge/Arcane-Client/issues"
  },
  "license": [
    "CC0-1.0",
    "OFL-1.1"
  ],
  "icon": "assets/arcaneclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.arcaneclient.ArcaneClient"
    ]
  },
  "mixins": [
    {
      "config": "arcaneclient.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": ">=0.141.6"
  }

}
