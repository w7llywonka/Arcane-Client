{
  "schemaVersion": 1,
  "id": "arcaneclient",
  "version": "${version}",
  "name": "${clientName}",
  "description": "${clientDescription}",
  "authors": [
    "Eric and Codex"
  ],
  "contact": {
    "sources": "https://github.com/w7llywonka/Arcane-Client",
    "issues": "https://github.com/w7llywonka/Arcane-Client/issues"
  },
  "license": [
    "CC0-1.0",
    "OFL-1.1"
  ],
  "icon": "assets/arcaneclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.arcaneclient.ArcaneClient"
    ]
  },
  "mixins": [
    {
      "config": "arcaneclient.client.mixins.json",
      "environment": "client"
    },
    {
      "config": "arcaneclient.additions.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.3",
    "java": ">=25",
    "fabric-api": ">=0.160.6"
  }

}
